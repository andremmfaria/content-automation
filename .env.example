# Social automation — required environment variables
# Copy this file to .env (gitignored) and fill in real values.
# NEVER commit the .env file.

# DEV.to / Forem API key
# Obtain at: https://dev.to/settings/extensions → "DEV Community API Keys"
DEVTO_API_KEY=your_devto_api_key_here

# Buffer OAuth access token
# Obtain at: https://developers.buffer.com → authenticate your app, then
# exchange for an access token via the OAuth flow.
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# Buffer channel id for your LinkedIn profile
# Obtain by calling: GET https://api.buffer.com (query { channels { id service } })
# and finding the id where service == "linkedin".
BUFFER_LINKEDIN_CHANNEL_ID=your_buffer_linkedin_channel_id_here

# (Optional) Path to a file whose first line is the Markdown article to publish next
# Leave unset to skip the auto-publish step in run_weekly.sh
DEVTO_QUEUE_FILE=/path/to/queue.txt

# (Optional) Override curation tags (space-separated, default: ai security devops)
CURATION_TAGS=ai security devops

# (Optional) Override max curation results (default: 15)
CURATION_LIMIT=15

# (Optional) Path where curated JSON is written (default: /tmp/devto_curation_YYYYMMDD.json)
CURATION_OUTPUT=/tmp/devto_curation_latest.json
